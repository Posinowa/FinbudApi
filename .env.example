# FinbudApi ortam değişkenleri
# Bu dosyayı .env adıyla kopyalayıp değerleri doldur. .env asla git'e eklenmez.

# ── Uygulama ──────────────────────────────────────────────────
APP_PORT=

# ── Veritabanı ────────────────────────────────────────────────
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── Kimlik doğrulama ──────────────────────────────────────────
# Değişirse tüm kullanıcıların oturumu düşer
JWT_SECRET=

# ── CORS ──────────────────────────────────────────────────────
# Virgülle ayrılmış izinli origin listesi
ALLOWED_ORIGINS=

# ── Bakım modu ve güncelleme bildirimi (/status) ──────────────
MAINTENANCE_MODE=false
UPDATE_AVAILABLE=false
ANDROID_STORE_URL=
IOS_STORE_URL=

# ── E-posta (SMTP) ────────────────────────────────────────────
# Boş bırakılırsa smtp.gmail.com ve 587 kullanılır
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ── Sadece Oracle sunucusu (Caddy) ────────────────────────────
# Sunucunun DuckDNS adresi, örnek: finbud-api.duckdns.org
ORACLE_HOST=
# Cloud Run yönlendiricisiyle paylaşılan uzun, rastgele değer
PROXY_SECRET=